# Hefesto Secrets & Environment Variables
# This file contains sensitive information and should NOT be committed to git.
# These values are used by .hefesto/hefesto.yaml

# ============ GITHUB ============
# Personal Access Token with repo scope
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token
# GitHub owner (organization or username)
GITHUB_OWNER=vinimlo
# Repository name
GITHUB_REPO=macweep

# ============ AI PROVIDER SECRETS (Optional) ============
# Only needed if not using default environment authentication
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ============ SLACK (Optional) ============
# Webhook URL for notifications
# Create at: https://api.slack.com/messaging/webhooks
# Format: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=
